<!DOCTYPE UI><UI version="3.3" stdsetdef="1">
<class>MainNFSForm</class>
<author>Julien Morot</author>
<widget class="QMainWindow">
    <property name="name">
        <cstring>MainNFSForm</cstring>
    </property>
    <property name="geometry">
        <rect>
            <x>0</x>
            <y>0</y>
            <width>642</width>
            <height>501</height>
        </rect>
    </property>
    <property name="sizePolicy">
        <sizepolicy>
            <hsizetype>5</hsizetype>
            <vsizetype>5</vsizetype>
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
        </sizepolicy>
    </property>
    <property name="minimumSize">
        <size>
            <width>21</width>
            <height>172</height>
        </size>
    </property>
    <property name="maximumSize">
        <size>
            <width>32767</width>
            <height>32767</height>
        </size>
    </property>
    <property name="baseSize">
        <size>
            <width>0</width>
            <height>0</height>
        </size>
    </property>
    <property name="caption">
        <string>NFS Server Configuration</string>
    </property>
    <widget class="QListView">
        <column>
            <property name="text">
                <string>Directory</string>
            </property>
            <property name="clickable">
                <bool>true</bool>
            </property>
            <property name="resizable">
                <bool>true</bool>
            </property>
        </column>
        <column>
            <property name="text">
                <string>Hosts</string>
            </property>
            <property name="clickable">
                <bool>true</bool>
            </property>
            <property name="resizable">
                <bool>true</bool>
            </property>
        </column>
        <column>
            <property name="text">
                <string>Permissions</string>
            </property>
            <property name="clickable">
                <bool>true</bool>
            </property>
            <property name="resizable">
                <bool>true</bool>
            </property>
        </column>
        <property name="name">
            <cstring>listNfsExport</cstring>
        </property>
        <property name="geometry">
            <rect>
                <x>0</x>
                <y>0</y>
                <width>640</width>
                <height>420</height>
            </rect>
        </property>
        <property name="sizePolicy">
            <sizepolicy>
                <hsizetype>4</hsizetype>
                <vsizetype>4</vsizetype>
                <horstretch>0</horstretch>
                <verstretch>0</verstretch>
            </sizepolicy>
        </property>
    </widget>
</widget>
<menubar>
    <property name="name">
        <cstring>MenuBar</cstring>
    </property>
    <item text="&amp;File" name="fileMenu">
        <action name="fileNewAction"/>
        <action name="fileEditAction"/>
        <action name="fileDeleteAction"/>
        <action name="fileSaveAction"/>
        <separator/>
        <action name="fileExitAction"/>
    </item>
    <item text="Service" name="Service">
        <action name="serviceStartAction"/>
        <action name="serviceStopAction"/>
        <action name="serviceRestartAction"/>
    </item>
    <item text="&amp;Help" name="helpMenu">
        <action name="helpAboutAction"/>
    </item>
</menubar>
<toolbars>
    <toolbar dock="2">
        <property name="name">
            <cstring>toolBar</cstring>
        </property>
        <property name="label">
            <string>Tools</string>
        </property>
        <action name="fileNewAction"/>
        <action name="fileSaveAction"/>
        <action name="fileEditAction"/>
        <action name="fileDeleteAction"/>
        <action name="fileExitAction"/>
    </toolbar>
</toolbars>
<actions>
    <action>
        <property name="name">
            <cstring>fileNewAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image0</iconset>
        </property>
        <property name="text">
            <string>New</string>
        </property>
        <property name="menuText">
            <string>&amp;New</string>
        </property>
        <property name="accel">
            <string>Ctrl+N</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>fileSaveAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image1</iconset>
        </property>
        <property name="text">
            <string>Save</string>
        </property>
        <property name="menuText">
            <string>&amp;Save</string>
        </property>
        <property name="accel">
            <string>Ctrl+S</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>fileExitAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image2</iconset>
        </property>
        <property name="text">
            <string>Exit</string>
        </property>
        <property name="menuText">
            <string>E&amp;xit</string>
        </property>
        <property name="accel">
            <string>Ctrl+Q</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>helpAboutAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image3</iconset>
        </property>
        <property name="text">
            <string>About</string>
        </property>
        <property name="menuText">
            <string>&amp;About</string>
        </property>
        <property name="accel">
            <string></string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>serviceStopAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image4</iconset>
        </property>
        <property name="text">
            <string>Stop service</string>
        </property>
        <property name="menuText">
            <string>Stop service</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>serviceStartAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image5</iconset>
        </property>
        <property name="text">
            <string>Start service</string>
        </property>
        <property name="menuText">
            <string>Start service</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>serviceRestartAction</cstring>
        </property>
        <property name="on">
            <bool>false</bool>
        </property>
        <property name="enabled">
            <bool>true</bool>
        </property>
        <property name="iconSet">
            <iconset>image6</iconset>
        </property>
        <property name="text">
            <string>Restart service</string>
        </property>
        <property name="menuText">
            <string>Restart service</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>fileDeleteAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image7</iconset>
        </property>
        <property name="text">
            <string>Delete</string>
        </property>
        <property name="menuText">
            <string>&amp;Delete</string>
        </property>
        <property name="toolTip">
            <string>Delete share</string>
        </property>
        <property name="accel">
            <string>Ctrl+D</string>
        </property>
    </action>
    <action>
        <property name="name">
            <cstring>fileEditAction</cstring>
        </property>
        <property name="iconSet">
            <iconset>image8</iconset>
        </property>
        <property name="text">
            <string>Edit</string>
        </property>
        <property name="menuText">
            <string>&amp;Edit</string>
        </property>
        <property name="accel">
            <string>Ctrl+E</string>
        </property>
    </action>
</actions>
<images>
    <image name="image0">
        <data format="PNG" length="539"></data>
    </image>
    <image name="image1">
        <data format="PNG" length="763"></data>
    </image>
    <image name="image2">
        <data format="PNG" length="1343"></data>
    </image>
    <image name="image3">
        <data format="PNG" length="943"></data>
    </image>
    <image name="image4">
        <data format="PNG" length="1073"></data>
    </image>
    <image name="image5">
        <data format="PNG" length="1205"></data>
    </image>
    <image name="image6">
        <data format="PNG" length="1363"></data>
    </image>
    <image name="image7">
        <data format="PNG" length="773"></data>
    </image>
    <image name="image8">
        <data format="PNG" length="847"></data>
    </image>
</images>
<connections>
    <connection>
        <sender>fileDeleteAction</sender>
        <signal>activated()</signal>
        <receiver>MainNFSForm</receiver>
        <slot>fileDelete()</slot>
    </connection>
    <connection>
        <sender>fileEditAction</sender>
        <signal>activated()</signal>
        <receiver>MainNFSForm</receiver>
        <slot>fileEdit()</slot>
    </connection>
    <connection>
        <sender>fileExitAction</sender>
        <signal>activated()</signal>
        <receiver>MainNFSForm</receiver>
        <slot>fileExit()</slot>
    </connection>
    <connection>
        <sender>fileNewAction</sender>
        <signal>activated()</signal>
        <receiver>MainNFSForm</receiver>
        <slot>fileNew()</slot>
    </connection>
    <connection>
        <sender>helpAboutAction</sender>
        <signal>activated()</signal>
        <receiver>MainNFSForm</receiver>
        <slot>helpAbout()</slot>
    </connection>
    <connection>
        <sender>fileSaveAction</sender>
        <signal>activated()</signal>
        <receiver>MainNFSForm</receiver>
        <slot>fileSave()</slot>
    </connection>
    <connection>
        <sender>serviceRestartAction</sender>
        <signal>activated()</signal>
        <receiver>MainNFSForm</receiver>
        <slot>serviceRestart()</slot>
    </connection>
    <connection>
        <sender>serviceStartAction</sender>
        <signal>activated()</signal>
        <receiver>MainNFSForm</receiver>
        <slot>serviceStart()</slot>
    </connection>
    <connection>
        <sender>serviceStopAction</sender>
        <signal>activated()</signal>
        <receiver>MainNFSForm</receiver>
        <slot>serviceStop()</slot>
    </connection>
    <connection>
        <sender>listNfsExport</sender>
        <signal>doubleClicked(QListViewItem*)</signal>
        <receiver>MainNFSForm</receiver>
        <slot>listNfsExport_doubleClicked(QListViewItem*)</slot>
    </connection>
    <connection>
        <sender>listNfsExport</sender>
        <signal>returnPressed(QListViewItem*)</signal>
        <receiver>MainNFSForm</receiver>
        <slot>listNfsExport_returnPressed(QListViewItem*)</slot>
    </connection>
</connections>
<includes>
    <include location="local" impldecl="in implementation">mainwindow.ui.h</include>
</includes>
<slots>
    <slot>fileDelete()</slot>
    <slot>fileEdit()</slot>
    <slot>fileExit()</slot>
    <slot>fileNew()</slot>
    <slot>fileSave()</slot>
    <slot>helpAbout()</slot>
    <slot>serviceRestart()</slot>
    <slot>serviceStart()</slot>
    <slot>serviceStop()</slot>
    <slot>listNfsExport_doubleClicked( QListViewItem * )</slot>
    <slot>listNfsExport_returnPressed( QListViewItem * )</slot>
</slots>
<layoutdefaults spacing="6" margin="11"/>
</UI>
